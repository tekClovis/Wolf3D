#!/bin/42sh

# Afficher un message
echo "Début du script tcsh"

# Afficher la date actuelle
echo "La date actuelle est : `date`"

# Lister les fichiers dans le répertoire courant
echo "Liste des fichiers dans le répertoire courant :"
ls -l

# Sauvegarder la liste dans un fichier
ls -l > liste_fichiers.txt
echo "Liste des fichiers sauvegardée dans liste_fichiers.txt"

# Fin du script
echo "Fin du script"